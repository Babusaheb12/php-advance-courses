{
  "openapi": "3.0.0",
  "info": {
    "title": "PHP Advanced Courses API",
    "description": "REST API for managing student records using PHP OOP and MySQL. This API provides endpoints to fetch, create, update, and delete student data.",
    "version": "1.0.0",
    "contact": {
      "name": "Babusaheb",
      "url": "https://github.com/Babusaheb12"
    }
  },
  "servers": [
    {
      "url": "http://localhost/php-advance-courses",
      "description": "Local development server (XAMPP)"
    }
  ],
  "paths": {
    "/Api/fetchAllData.php": {
      "get": {
        "tags": ["Students"],
        "summary": "Fetch all student records",
        "description": "Retrieves all student records from the database and returns them as JSON. Returns empty array if no records exist.",
        "operationId": "fetchAllStudents",
        "responses": {
          "200": {
            "description": "Successfully retrieved all student records",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Student"
                  }
                },
                "examples": {
                  "success": {
                    "summary": "Array of student records",
                    "value": [
                      {
                        "id": 1,
                        "name": "John Doe",
                        "email": "john@example.com",
                        "phone": "1234567890",
                        "enrollment_date": "2025-01-01"
                      },
                      {
                        "id": 2,
                        "name": "Jane Smith",
                        "email": "jane@example.com",
                        "phone": "0987654321",
                        "enrollment_date": "2025-01-05"
                      }
                    ]
                  }
                }
              }
            }
          },
          "200-empty": {
            "description": "No records found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "status": {
                      "type": "boolean"
                    }
                  }
                },
                "examples": {
                  "empty": {
                    "summary": "No records found response",
                    "value": {
                      "message": "No Records Found",
                      "status": false
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Database query error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Student": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "Unique student identifier (Primary Key)",
            "example": 1
          },
          "name": {
            "type": "string",
            "description": "Full name of the student",
            "example": "John Doe"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Student email address",
            "example": "john@example.com"
          },
          "phone": {
            "type": "string",
            "description": "Student contact phone number",
            "example": "1234567890"
          },
          "enrollment_date": {
            "type": "string",
            "format": "date",
            "description": "Date when student enrolled",
            "example": "2025-01-01"
          }
        }
      }
    }
  }
}
